#!/bin/sh

DAEMON="unudhcpd"
EXEC="/usr/bin/$DAEMON"
PIDFILE="/var/run/$DAEMON.pid"
CONF="/etc/unudhcpd.conf"

if [ -f "$CONF" ]; then
	source "$CONF"
else
	exit 1
fi

start() {
	if ! ifconfig "$UNUDHCPD_INTERFACE" >/dev/null 2>&1; then
		echo "FAIL ($UNUDHCPD_INTERFACE interface not found)"
		return 1
	fi

	printf "Starting %s: " "$DAEMON"
	
	# Start the daemon in the background
	start-stop-daemon --start --quiet --background \
		--make-pidfile --pidfile "$PIDFILE" \
		--exec "$EXEC" -- \
		-i "$UNUDHCPD_INTERFACE" \
		-s "$UNUDHCPD_HOST_IP" \
		-c "$UNUDHCPD_CLIENT_IP"
	
	status=$?
	[ "$status" -eq 0 ] && echo "OK" || echo "FAIL"
	return "$status"
}

stop() {
	printf "Stopping %s: " "$DAEMON"
	start-stop-daemon --stop --quiet --pidfile "$PIDFILE"
	status=$?
	
	if [ "$status" -eq 0 ]; then
		echo "OK"
		rm -f "$PIDFILE"
	else
		echo "FAIL"
	fi
	return "$status"
}

restart() {
	stop
	sleep 1
	start
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		restart
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac

exit 0
